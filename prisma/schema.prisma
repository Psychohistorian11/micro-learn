generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model OtpCode {
  id        Int      @id @default(autoincrement())
  email     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
}

model User {
  id             String              @id @default(uuid())
  email          String              @unique
  username       String              @unique
  password       String
  profilePicture String              @default("")
  description    String              @default("")
  role           Role
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  resources      Resource[]          @relation("UserResources")
  communities    User_Community[]
  requests       Community_Request[]

  @@map("users")
}

model Community {
  id          String   @id @default(uuid())
  title       String
  image       String   @default("")
  description String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  avatar      String   @default("")
  isPublic    Boolean  @default(true)

  requests  Community_Request[]
  resources Resource_Community[]
  users     User_Community[]
}

model Community_Request {
  id          String        @id @default(uuid())
  userId      String
  communityId String
  status      RequestStatus @default(Pending)
  createdAt   DateTime      @default(now())
  respondedAt DateTime?
  community   Community     @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User_Community {
  id          String        @id @default(uuid())
  userId      String
  communityId String
  role        CommunityRole
  community   Community     @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Resource {
  id          String               @id @default(uuid())
  title       String
  isPublic    Boolean              @default(true)
  image       String               @default("")
  description String
  attachment  String
  type        ResourceType
  authorId    String
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  avatar      String               @default("")
  author      User                 @relation("UserResources", fields: [authorId], references: [id], onDelete: Cascade)
  areas       Resource_Area[]
  communities Resource_Community[]
}

model Area {
  id        String          @id @default(uuid())
  name      String          @unique
  color     String          @default("")
  icon      String          @default("")
  resources Resource_Area[]
}

model Resource_Area {
  id         String   @id @default(uuid())
  resourceId String
  areaId     String
  area       Area     @relation(fields: [areaId], references: [id], onDelete: Cascade)
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
}

model Resource_Community {
  id          String    @id @default(uuid())
  resourceId  String
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  resource    Resource  @relation(fields: [resourceId], references: [id], onDelete: Cascade)
}

enum CommunityRole {
  Admin
  Mod
  Member
}

enum Role {
  teacher
  student
}

enum ResourceType {
  Video
  Podcast
  Slides
  Infography
  Text
}

enum RequestStatus {
  Pending
  Accepted
  Rejected
}
